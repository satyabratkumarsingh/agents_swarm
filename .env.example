# Required by LangChain/DeepAgents for planning, worker runs, and final report.
ANTHROPIC_API_KEY=

# Defaults to claude-sonnet-4-5.
# TEAM_MODEL=claude-sonnet-4-5

# Optional endpoint override for a compatible proxy.
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-endpoint

# Host folder mounted into each QuickSand VM at /workspace.
# TEAM_WORKSPACE=./workspace
